# データベース接続情報（shift-scheduler-ai の PostgreSQL）
DATABASE_URL=postgresql://username:password@host:port/database

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# サーバー設定
PORT=3001

# テナントID
TENANT_ID=3

# LIFF App ID（メッセージ内のURL用）
LIFF_ID=2008227932-Rq9rJrJn

# 通知有効/無効（テスト時は false にして実際の送信を抑止）
NOTIFICATION_ENABLED=true

# cron で自動送信するリマインドフェーズ（カンマ区切り、未設定時は全フェーズ有効）
# 1=7日前, 2=3日前, 3=1日前, 4=締切当日
AUTO_REMIND_PHASES=1,2,3,4

# 管理者API（締め切り設定変更）の Basic 認証情報
# 未設定の場合、管理者APIは無効（503を返す）
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASS=change_me

# Slack Incoming Webhook（cron発火通知・エラーアラート用、#agent-alerts 宛）
# 未設定でも cron/ログは動作する（Slack投稿のみ no-op + warn）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# 成功時のSlack通知トグル（false でエラー時のみ通知。未設定時は通知する）
SLACK_NOTIFY_ON_SUCCESS=true
